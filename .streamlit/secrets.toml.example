# Plantilla de secrets para el explorador de cambio climatico.
#
# Local: copiar a `.streamlit/secrets.toml` (mismo nivel) y rellenar.
# Streamlit Cloud: pegar este contenido en
#   App settings -> Secrets.
#
# Si NO se configura el bloque [github], la seleccion cae a JSON local
# (`seleccion_revision.json`) y solo es apta para desarrollo local.
# La seccion de comentarios del piloto NO debe operar sin backend durable.

[github]
# Personal Access Token con permiso `Contents: read & write` sobre el repo destino.
# Crear en: https://github.com/settings/tokens?type=beta
token = "ghp_xxx_reemplazar"

# Repo donde se versiona el JSON. Formato "owner/nombre".
repo = "CepalLab/cambio-climatico"

# Ruta dentro del repo para la seleccion.
path = "seleccion_revision.json"

# Rama destino. Por defecto: main
branch = "main"

[github_comments]
# Persistencia durable exclusiva para comentarios del piloto.
# Puede reutilizar el mismo token/repo o apuntar a otro repo si conviene.
token = "ghp_xxx_reemplazar"
repo = "CepalLab/cambio-climatico"
comments_path = "fase2/pilot/comentarios_revision.json"
branch = "main"
